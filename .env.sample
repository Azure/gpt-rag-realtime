# ──────────────────────────────────────────────
# Azure OpenAI
# ──────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-4o-realtime-preview
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# ──────────────────────────────────────────────
# Azure Communication Services (ACS)
# ──────────────────────────────────────────────
ACS_CONNECTION_STRING=endpoint=https://<your-acs-resource>.communication.azure.com/;accesskey=<key>
ACS_PHONE_NUMBER=+1XXXXXXXXXX
ACS_WEBSOCKET_URL=wss://<your-acs-websocket-url>

# (Optional) Default target phone number — can be overridden via UI
TARGET_PHONE_NUMBER=

# Public base URL for ACS callbacks (ngrok / dev tunnel / container app FQDN). No trailing slash.
CALLBACK_URI_HOST=https://<your-ngrok-or-tunnel-url>

# Cognitive Services endpoint (for speech recognition in ACS)
COGNITIVE_SERVICES_ENDPOINT=https://<your-cognitive-services>.cognitiveservices.azure.com/

# ──────────────────────────────────────────────
# Azure AI Search
# ──────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-admin-or-query-key>
AZURE_SEARCH_INDEX=<your-index-name>

# (Optional) Semantic configuration name — omit to use simple search
AZURE_SEARCH_SEMANTIC_CONFIGURATION=

# Field mappings (defaults shown — override if your index uses different names)
AZURE_SEARCH_IDENTIFIER_FIELD=chunk_id
AZURE_SEARCH_CONTENT_FIELD=chunk
AZURE_SEARCH_TITLE_FIELD=title
AZURE_SEARCH_EMBEDDING_FIELD=text_vector

# Set to "true" to enable vector / hybrid search, "false" for text-only
AZURE_SEARCH_USE_VECTOR_QUERY=true

# ──────────────────────────────────────────────
# Live Agent Transfer
# ──────────────────────────────────────────────
# (Optional) Phone number for live agent transfers (default: +19722135344)
LIVE_AGENT_PHONE_NUMBER=+19722135344
